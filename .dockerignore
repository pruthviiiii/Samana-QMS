# Deny everything, then allow exactly what the Dockerfile copies. An allow-list
# rather than a deny-list, so a new credential file or scratch directory cannot
# reach an image by being forgotten here.
#
# Keep in step with the COPY lines in Dockerfile.
*

# --- Workspace manifests, copied before npm ci for layer caching --------------
!package.json
!package-lock.json
!tsconfig.json
!prisma.config.ts

# --- The three workspaces -----------------------------------------------------
# The directory entry is re-included as well as its contents. Negating only
# `dir/**` leaves the directory itself excluded, which is enough to break a
# `COPY dir/ ./dir/` on some builders.
!shared
!shared/**
!backend
!backend/**
!frontend
!frontend/**

# --- Migrations and the build and operational scripts -------------------------
!db
!db/**
!scripts
!scripts/**

# --- Nothing generated, ever --------------------------------------------------
# These would otherwise slip in under the allow rules above and either bloat the
# image or overwrite what the build produces.
**/node_modules
**/.next
**/generated
**/*.tsbuildinfo
dist-node
dist-api
dist-worker

# --- Nothing secret -----------------------------------------------------------
**/.env
**/.env.*
**/.dev.vars*
