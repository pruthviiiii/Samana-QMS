# Every value here is validated once when the server or the scheduler starts
# (lib/config.ts). A missing or malformed setting stops the process with a
# message naming the variable, before it serves anyone. An empty value means
# "unset", which is how hosting dashboards express it.

# Any PostgreSQL 14 or newer server. Add ?sslmode=verify-full when the server uses TLS
# (managed hosts do); leave it out for a plain local server. Required.
DATABASE_URL=postgresql://qms_app:PASSWORD@localhost:5432/samana_qms
# Owner connection string used only by scripts/migrate.mjs and scripts/create-app-role.mjs.
# Leave empty to run migrations with DATABASE_URL (the owner) instead.
MIGRATE_DATABASE_URL=

# The address customers and staff reach, used for the origin check on every
# state change and for QR and SMS links. Required, absolute.
APP_ORIGIN=http://localhost:3000
# Must agree with the scheme of APP_ORIGIN: "true" (the default) for https://,
# "false" only for a local http:// setup. A Secure cookie on an http origin is
# dropped by every browser, so nobody could sign in; an insecure cookie on an
# https origin is refused. Any value other than true or false is refused.
SESSION_COOKIE_SECURE=false

SALESFORCE_INSTANCE_URL=https://samanadevelopers--pod2.sandbox.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=67.0
# "true" requires the three connection values above.
SALESFORCE_WRITE_ENABLED=false

# Set only behind a proxy that appends the client address to this header
# (Render: x-forwarded-for). The last entry in the list is used. One of:
# cf-connecting-ip, true-client-ip, x-real-ip, x-forwarded-for.
TRUSTED_CLIENT_IP_HEADER=

# Secrets: at least 16 characters each, independent of each other. Generate
# with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# WORKER_SECRET is needed only by a cron-style host that calls POST /api/jobs/run;
# the Render scheduler works directly against the database and does not use it.
WORKER_SECRET=
QR_SIGNING_SECRET=

# "true" requires an https:// gateway address and a token.
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Sender id, at most 11 characters.
SMS_SENDER=SAMANA

# First administrator, used once by scripts/bootstrap.mjs. Remove the password
# from the host afterwards: in production its presence pages the uptime monitor.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=

# Retention, applied by the scheduler at most once an hour. Empty keeps
# everything. Identifier days: anonymise name, mobile, Emirates ID and passport
# on tickets closed longer ago than this. Event days: delete older audit events.
# Whole numbers of days greater than zero.
RETENTION_IDENTIFIER_DAYS=
RETENTION_EVENT_DAYS=
