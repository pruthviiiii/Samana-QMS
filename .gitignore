# What never belongs in the repository. Everything here is either generated by
# a command in package.json, local to one machine, or a credential.

# --- Dependencies -------------------------------------------------------------
node_modules/

# --- Build output -------------------------------------------------------------
# Each is produced by a build script and reproducible from source.
#   frontend/.next, .next   next build           (web tier)
#   dist-node/              npm run build:node   (standalone server)
#   dist-api/               npm run build:api    (API bundle)
#   dist-worker/            npm run build:worker (scheduler bundle)
#   backend/generated/      prisma generate      (typed client)
.next/
dist/
dist-node/
dist-api/
dist-worker/
backend/generated/
*.tsbuildinfo

# Generated client at its pre-workspace path, so an older checkout stays clean.
lib/generated/

# --- Test and analysis output -------------------------------------------------
coverage/

# --- Credentials --------------------------------------------------------------
# Every real environment file. .env.example is the committed template, and
# deploy/ holds one annotated template per process.
.env
.env.*
!.env.example
.dev.vars*

# --- Local machine state ------------------------------------------------------
# Editor, agent and CLI caches. Useful locally, meaningless to anyone else.
.claude/
.vscode/
.idea/
.sf/
.sfdx/

# --- Internal documentation ---------------------------------------------------
# Design, operations and review documents are kept with the team, not in the
# repository. openapi.json is the exception: it is generated from the route
# table and pinned by tests/openapi.test.ts, so a clone must carry it.
docs/
!docs/openapi.json

# --- Scratch ------------------------------------------------------------------
# Working directories for investigations, document generation and experiments.
.analysis/
.wrangler/
.vinext/
output/
tmp/

# --- Logs ---------------------------------------------------------------------
logs
*.log
npm-debug.log*

# --- Operating system ---------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
