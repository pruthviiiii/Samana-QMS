# ==============================================================================
#  API SERVICE  —  internal HTTP, holds every credential
# ==============================================================================
#  Build      : npm ci --include=dev && npm run build:api
#  Pre-deploy : node scripts/migrate.mjs
#  Start      : node dist-api/api.mjs
#  Port       : API_PORT, or PORT if the platform assigns one (default 3001)
#  Health     : GET /api/health
#
#  Every value is validated once at start (lib/config.ts). A missing or
#  malformed setting stops the process with a message naming the variable,
#  before it serves anyone. An empty value means "unset".
#
#  Store these as platform secrets, not in a file in the repository.
# ==============================================================================

NODE_ENV=production
API_PORT=3001

# --- Database -----------------------------------------------------------------
# Runtime connection, the RESTRICTED role. Read and write rows and execute
# functions; no schema changes. Created by scripts/create-app-role.mjs or
# deploy/provision-database.sql.
# Add ?sslmode=verify-full for any managed or remote server.
DATABASE_URL=postgresql://qms_app:PASSWORD@db.example.com:5432/samana_qms?sslmode=verify-full

# Owner connection, used ONLY by scripts/migrate.mjs and create-app-role.mjs.
# Needed by whatever runs the pre-deploy migration step. If your platform runs
# migrations somewhere the app environment is not available, set it there
# instead and leave this empty.
MIGRATE_DATABASE_URL=postgresql://qms_owner:PASSWORD@db.example.com:5432/samana_qms?sslmode=verify-full

# --- Identity and origin ------------------------------------------------------
# Must be the same value as on the web tier — the API checks it on every
# state-changing request.
APP_ORIGIN=https://qms.example.com

# Must agree with the scheme of APP_ORIGIN: "true" for https://, "false" only
# for a local http:// setup. A Secure cookie on an http origin is dropped by
# every browser, so nobody could sign in. The process refuses to start if the
# two disagree.
SESSION_COOKIE_SECURE=true

# --- Gate in front of this service --------------------------------------------
# Identical to API_PROXY_TOKEN on the web tier. The API refuses any request
# that does not carry it, except GET /api/health for the load balancer.
# A production API REFUSES TO START without this.
API_PROXY_TOKEN=

# Set to true ONLY where this service has no address reachable from the
# internet. It waives the requirement above; do not set it to work around a
# misconfigured token.
API_TRUSTS_NETWORK=false

# The header carrying the real client address, for per-address rate limits.
# Behind the web tier use x-client-address: the web tier overwrites it on every
# forwarded request, so a client cannot forge it. Leave empty when nothing
# trustworthy sets one — an untrusted header is worse than none.
# One of: x-client-address, cf-connecting-ip, true-client-ip, x-real-ip,
#         x-forwarded-for
TRUSTED_CLIENT_IP_HEADER=x-client-address

# --- Secrets ------------------------------------------------------------------
# At least 16 characters each, independent of one another.
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"

# Signs the rotating check-in QR code. Required for QR check-in to work.
QR_SIGNING_SECRET=

# Only needed if a cron-style host calls POST /api/jobs/run instead of running
# the scheduler process. The scheduler works directly against the database and
# does not use this.
WORKER_SECRET=

# --- Salesforce ---------------------------------------------------------------
# Customer lookup on check-in, staff search, and visit write-back.
# Point at the PRODUCTION org for a production deployment — the value below is
# a sandbox.
SALESFORCE_INSTANCE_URL=https://samanadevelopers.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=67.0

# Writing finished visits back to Salesforce. Requires the three values above.
# Keep false until one visit has been verified end to end in the target org.
SALESFORCE_WRITE_ENABLED=false

# --- SMS ----------------------------------------------------------------------
# Texting customers their ticket number. Requires an https gateway and a token.
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=SAMANA

# --- First administrator ------------------------------------------------------
# Used once by scripts/bootstrap.mjs, then REMOVE IT FROM THIS ENVIRONMENT.
# While it is set in production, GET /api/health/alerts reports
# bootstrap_password_present and returns 503.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=

# --- Retention ----------------------------------------------------------------
# Applied by the scheduler, at most once an hour. Empty keeps everything.
# Identifier days: anonymise name, mobile, Emirates ID and passport on tickets
#                  closed longer ago than this.
# Event days     : delete audit events older than this.
# Whole numbers of days greater than zero. Set these only once the business has
# agreed a retention period.
RETENTION_IDENTIFIER_DAYS=
RETENTION_EVENT_DAYS=
