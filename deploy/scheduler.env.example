# ==============================================================================
#  SCHEDULER  —  background worker. NO PORT, NO URL, NO HEALTH-CHECK PATH.
# ==============================================================================
#  Build : npm ci --include=dev && npm run build:worker
#  Start : node dist-worker/worker.mjs
#  Type  : background worker / daemon — NOT a web service
#  Scale : exactly one instance
#
#  Deploy this as a worker. On platforms that only offer web services it will
#  fail a health check forever, because it never opens a port.
#
#  WHAT IT DOES, every 15 seconds:
#    - routes customers who are still waiting
#    - marks staff offline whose screen has stopped responding, and moves their
#      customers on
#    - sends finished visits to Salesforce, and SMS if enabled
#    - rolls the day over and applies retention
#
#  IF THIS IS NOT RUNNING the system still looks healthy: customers can check
#  in and staff can call people by hand. But nothing is re-routed and NO VISIT
#  EVER REACHES SALESFORCE. Confirm it is alive after every release:
#    curl https://<web-host>/api/health/scheduler     # lastRun must advance
#
#  It connects straight to the database. It does NOT call the API, needs no
#  route to it, and needs no API_PROXY_TOKEN.
# ==============================================================================

NODE_ENV=production

# --- Database -----------------------------------------------------------------
# The same restricted runtime role the API uses.
DATABASE_URL=postgresql://qms_app:PASSWORD@db.example.com:5432/samana_qms?sslmode=verify-full

# --- Required by configuration validation --------------------------------------
# The scheduler validates the same settings as the API, so these must be present
# and must agree with each other even though it serves no browser.
APP_ORIGIN=https://qms.example.com
SESSION_COOKIE_SECURE=true

# --- Salesforce ---------------------------------------------------------------
# The scheduler is what actually delivers finished visits, so these must match
# the API's values. If they differ, visits fail delivery and are reported on
# GET /api/health/alerts as outbox_failed.
SALESFORCE_INSTANCE_URL=https://samanadevelopers.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=67.0
SALESFORCE_WRITE_ENABLED=false

# --- SMS ----------------------------------------------------------------------
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=SAMANA

# --- Retention ----------------------------------------------------------------
# Must match the API's values. The scheduler is what applies them.
RETENTION_IDENTIFIER_DAYS=
RETENTION_EVENT_DAYS=

# --- Deliberately absent ------------------------------------------------------
# API_PORT             this process opens no port
# API_URL              it does not call the API
# API_PROXY_TOKEN      it is not behind the gate
# QR_SIGNING_SECRET    QR codes are issued by the API
# BOOTSTRAP_PASSWORD   bootstrap is a one-off script, not the worker
