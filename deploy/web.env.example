# ==============================================================================
#  WEB TIER  —  public HTTP, serves the screens
# ==============================================================================
#  Build : npm ci --include=dev && npm run build:node
#  Start : node dist-node/standalone/server.js
#  Port  : PORT (default 3000)
#  Health: GET /api/health
#
#  This tier holds NO database credential and NO Salesforce credential. That
#  absence is the security boundary — it is why the API is a separate process.
#  If you find yourself adding DATABASE_URL here, something is wrong.
#
#  Exactly four variables are read (webSchema in lib/config.ts). Anything else
#  set here is ignored.
# ==============================================================================

NODE_ENV=production

# The address users actually reach, including scheme and any non-default port.
# Used for the origin check on every state-changing request, and to build the
# QR check-in and SMS links. If this does not match the browser's address
# exactly, every save is refused with "Request origin is not allowed".
APP_ORIGIN=https://qms.example.com

# Where to forward /api. Use the API's PRIVATE address if the platform has a
# private network. A full URL, or host:port on platforms that hand out an
# internal address with no scheme.
#   private network : http://samana-qms-api:3001
#   same host       : http://127.0.0.1:3001
#   public address  : https://qms-api.example.com   (then the token below is
#                                                     mandatory)
API_URL=http://127.0.0.1:3001

# Shared secret proving a request came through this tier. Must be BYTE-IDENTICAL
# to API_PROXY_TOKEN on the API service. At least 16 characters.
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Leave empty ONLY if the API is genuinely unreachable from the internet and
# the API sets API_TRUSTS_NETWORK=true.
API_PROXY_TOKEN=
