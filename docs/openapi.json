      "post": {
        "summary": "Create a staff member",
        "description": "Signed-in session with role admin.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "x-roles": [
          "admin"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 120,
                    "pattern": "^[a-zA-Z0-9@._+-]+$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "email": {
                    "nullable": true,
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "hod",
                      "manager",
                      "agent",
                      "reception",
                      "display"
                    ]
                  },
                  "sfId": {
                    "nullable": true,
                    "type": "string",
