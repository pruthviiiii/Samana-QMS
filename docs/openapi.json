    "/api/tickets": {
      "post": {
        "summary": "Issue a ticket from a lookup; idempotent by requestId",
        "description": "Signed-in session with role admin, hod, manager, agent, reception, customer.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "x-roles": [
          "admin",
          "hod",
          "manager",
          "agent",
          "reception",
          "customer"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lookupId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "serviceId": {
                    "type": "string",
                    "enum": [
                      "crm-general",
                      "crm-noc",
                      "crm-refund",
                      "crm-handover",
                      "collection",
                      "general"
                    ]
                  },
                  "unitId": {
                    "nullable": true,
                    "type": "string",
                    "maxLength": 100
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "lookupId",
                  "serviceId",
                  "unitId",
                  "requestId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input; the body carries a human message"
          },
          "401": {
            "description": "Not signed in"
