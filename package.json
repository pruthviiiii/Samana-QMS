    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build.mjs",
    "start": "node --env-file=.env dist-node/standalone/server.js",
    "start:cloudflare": "wrangler dev --config dist/server/wrangler.json",
