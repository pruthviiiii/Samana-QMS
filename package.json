{
  "name": "samana-qms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Queue management for the Samana Customer Experience Centre. Three workspaces: frontend (screens), backend (API and scheduler), shared (the vocabulary both agree on).",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @qms/frontend",
    "build": "node scripts/build.mjs",
    "build:node": "node scripts/build.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "node --env-file=.env dist-node/standalone/frontend/server.js",
    "start:node": "node --env-file=.env dist-node/standalone/frontend/server.js",
    "api": "node --env-file=.env dist-api/api.mjs",
    "dev:api": "node --env-file=.env --watch dist-api/api.mjs",
    "worker": "node --env-file=.env dist-worker/worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint frontend/app frontend/components/qms frontend/lib frontend/proxy.ts frontend/instrumentation.ts frontend/next.config.ts backend shared tests scripts vitest.config.ts prisma.config.ts --ignore-pattern backend/generated",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:bootstrap": "node --env-file=.env scripts/bootstrap.mjs",
    "db:schema": "node --env-file=.env.test scripts/schema-snapshot.mjs",
    "db:app-role": "node --env-file=.env scripts/create-app-role.mjs",
    "api:docs": "node scripts/openapi.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "node --env-file=.env.test node_modules/prisma/build/index.js db pull"
  },
  "overrides": {
    "mysql2": ">=3.24.4",
    "deepmerge-ts": ">=8.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prisma": "^7.10.0",
    "shadcn": "^4.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
