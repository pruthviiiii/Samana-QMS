{
  "name": "samana-qms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:node": "node scripts/build.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "node --env-file=.env dist-node/standalone/server.js",
    "start:node": "node --env-file=.env dist-node/standalone/server.js",
    "worker": "node --env-file=.env dist-worker/worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app components/qms lib server tests scripts proxy.ts vitest.config.ts next.config.ts prisma.config.ts --ignore-pattern lib/generated",
    "test": "vitest run",
    "format": "oxfmt",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:bootstrap": "node --env-file=.env scripts/bootstrap.mjs",
    "db:schema": "node --env-file=.env.test scripts/schema-snapshot.mjs",
    "db:app-role": "node --env-file=.env scripts/create-app-role.mjs",
    "api:docs": "node scripts/openapi.mjs",
    "test:coverage": "vitest run --coverage",
    "build:api": "node scripts/build-api.mjs",
    "api": "node --env-file=.env dist-api/api.mjs",
    "dev:api": "node --env-file=.env --watch dist-api/api.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "node --env-file=.env.test node_modules/prisma/build/index.js db pull"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.31.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prisma": "^7.10.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "mysql2": ">=3.24.4",
    "deepmerge-ts": ">=8.0.2"
  }
}
