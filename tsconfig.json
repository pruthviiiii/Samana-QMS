{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./frontend/*"
      ],
      "@qms/shared": [
        "./shared/domain.ts"
      ],
      "@backend/*": [
        "./backend/*"
      ]
    }
  },
  "include": [
    "frontend/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "frontend/.next/types/**/*.ts",
    "frontend/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-api",
    "dist-node",
    "dist-worker",
    "frontend/.next",
    "backend/generated"
  ]
}
